# --- public (browser): Firebase web config only ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- server only (Vercel functions). Never prefix these with VITE_ ---
# Claude (console.anthropic.com): ranks and explains the flights, and scouts which days to price on SerpApi
ANTHROPIC_API_KEY=
# regular searches use Sonnet; the daily Deep Search uses Opus; Haiku writes the headline and summary
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_DEEP_MODEL=claude-opus-5-5
CLAUDE_SUMMARY_MODEL=claude-haiku-5-5
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# serpapi (live Google Flights) | travelpayouts (thin cache) | simulated (fake, for development)
FARE_PROVIDER=simulated
# base64 of the service-account JSON
FIREBASE_SERVICE_ACCOUNT_B64=
DAILY_REGULAR_LIMIT=4
DAILY_DEEP_LIMIT=1
IP_DAILY_LIMIT=15
GLOBAL_DAILY_LIMIT=300
# random string for IP hashing
DAILY_SALT=
# random string, HMAC key for phone-number hashes
PHONE_HASH_SECRET=
# Email codes: sign up free at brevo.com, verify a sender address, create an API key
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=flexfare
EMAIL_DAILY_LIMIT=250
# random string, HMAC key for emailed codes
EMAIL_CODE_SECRET=
# SerpApi: sign up free at serpapi.com, copy your API key (about 100 searches/month free)
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=100
SERPAPI_REGULAR_SEARCHES=3
SERPAPI_DEEP_SEARCHES=5
# "Book directly" (live checkout lookup, 1 to 2 SerpApi credits each): per user per day, and the HMAC key that
# signs the lookup reference sent with each route (falls back to DAILY_SALT)
BOOK_DAILY_LIMIT=6
BOOKING_SECRET=
# Admin accounts, comma-separated verified emails: no daily limits, and the /admin usage page. Keep it out of git.
ADMIN_EMAILS=
