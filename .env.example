# --- public (browser): Firebase web config only ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- server only (Vercel functions). Never prefix these with VITE_ ---
GROQ_API_KEY=
# regular searches use the small model; the daily Deep Search uses the large one
GROQ_MODEL=openai/gpt-oss-20b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# travelpayouts | simulated
FARE_PROVIDER=simulated
# base64 of the service-account JSON
FIREBASE_SERVICE_ACCOUNT_B64=
DAILY_REGULAR_LIMIT=4
DAILY_DEEP_LIMIT=1
IP_DAILY_LIMIT=15
GLOBAL_DAILY_LIMIT=300
# random string for IP hashing
DAILY_SALT=
# random string, HMAC key for phone-number hashes
PHONE_HASH_SECRET=
# Email codes: sign up free at brevo.com, verify a sender address, create an API key
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=flexfare
EMAIL_DAILY_LIMIT=250
# random string, HMAC key for emailed codes
EMAIL_CODE_SECRET=
