{
  "framework": "vite",
  "devCommand": "vite --port $PORT",
  "rewrites": [
    {
      "source": "/((?!api/|src/|node_modules/|@|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/curate.ts": {
      "maxDuration": 120
    },
    "api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
